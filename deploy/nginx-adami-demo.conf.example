# Example only — not deployed by this repository change.
# Strip /api/demo so the upstream sees /v1/*.
# Do NOT proxy_pass to Kernel :8000 or Health :8080.
# Demo API ignores X-Forwarded-For; only loopback peers may send X-Adami-Client-IP.

location = /api/demo/v1/internal/metrics {
    return 404;
}

location /api/demo/ {
    proxy_pass http://127.0.0.1:8091/;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    client_max_body_size 8k;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Adami-Demo-CSRF $http_x_adami_demo_csrf;
    proxy_set_header X-Adami-Client-IP $remote_addr;
    proxy_set_header Connection "";
}
