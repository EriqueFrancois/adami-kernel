# 仅将「不能明文进仓库的敏感项」复制到本机 .env（或直接在本机 .env 中只写这些变量名）。
# 路径、功能开关、定时训练时刻等非敏感项：请编辑 src/adami_kernel/config.py 中的默认值。

# ---------- i18n（模块六：默认语言可被 SecondBrain System/working-memory/locale.json 或每 chat 覆盖）----------
# ADAMI_DEFAULT_LOCALE=en（兼容/键基准，默认仍为英文）
# ADAMI_SYSTEM_UI_LOCALE=zh-Hans（未设置 ADAMI_UI_LOCALE 时，界面与 Report 默认语言；可改为 en）
# ADAMI_UI_LOCALE=（可选）显式覆盖界面/向导；clear 后恢复为 ADAMI_SYSTEM_UI_LOCALE
# ADAMI_REPORT_LOCALE=（可选）Report Studio 简报模板/固定标题语言；未设置则跟随 effective_ui_default_locale()
# 步骤 6：显式翻译模块（i18n/translate.py）；默认开启，仅在被调用时生效
# ADAMI_TRANSLATE_ENABLED=0
# ADAMI_TRANSLATE_TIMEOUT_SEC=30
# ADAMI_TRANSLATE_MAX_CHARS=50000
# ADAMI_TRANSLATE_CACHE_TTL_SEC=604800
# ADAMI_TRANSLATE_CACHE_DIR=（可选）覆盖默认 ADAMI_DATA_DIR/translate_cache
# ADAMI_SUPPORTED_LOCALES=["en","zh-Hans"]
# ADAMI_BRAIN_LOCALE_JSON_RELATIVE=System/working-memory/locale.json
# ADAMI_CLI_ENV_FILE=（可选）显式指定 CLI 向导覆盖 env 文件路径；未设置时见 config.py 中 cli_overrides_env_path() 规则

# ---------- Task queue（会话 FIFO 持久化；默认路径 ADAMI_DATA_DIR/task_queue.json）----------
# ADAMI_TASK_QUEUE_PATH=（可选）覆盖队列 JSON 绝对路径
# ADAMI_TASK_QUEUE_TTL_SEC=0（>0 时丢弃超过该秒数的「待处理」项；进行中任务不按此项过期）
# ADAMI_TASK_QUEUE_MAX_PER_CHAT=200（0=不限制；drop_oldest 模式下超限时丢最旧）
# ADAMI_TASK_QUEUE_MAX_TOTAL=5000（0=不限制；仅统计待处理条数之和）
# ADAMI_TASK_QUEUE_OVERFLOW_MODE=drop_oldest | reject（reject=满则不入队，用户见 dp.session.queue_capped）
# ADAMI_TASK_QUEUE_FERNET_KEY=（可选）Fernet URL-safe base64 密钥；设置后磁盘为 v2 加密封装（需已安装 cryptography）

# ---------- LLM ----------
# Intent adaptive Step 4 (optional JSON classifier; defaults live in config.py):
# ADAMI_INTENT_LLM_CLASSIFIER_ENABLED=0
# ADAMI_INTENT_CLASSIFIER_MIN_CONFIDENCE=0.55
# ADAMI_INTENT_CLASSIFIER_TIMEOUT_SEC=8
# ADAMI_INTENT_ACTION_PERMISSION_GRANTED=0   # Step 4.1: allow ``action`` to stay primary in multi-label merge
# ADAMI_INTENT_ADAPTIVE_PIPELINE_ENABLED=0   # Step 5: tiered intent (rules → optional LLM → templates) before Planner on COMPLEX_TASK
# ADAMI_INTENT_ADAPTIVE_FALLBACK_NOTICE=0    # Step 5: optional one-line user hint before Planner when templates do not apply
# Intent adaptive Step 8 (timeouts + ACTION template gate; defaults live in config.py):
# ADAMI_INTENT_ADAPTIVE_LLM_PHASE_TIMEOUT_SEC=15   # Outer asyncio.wait_for around the LLM classify phase (seconds)
# ADAMI_INTENT_TEMPLATE_EXECUTE_TIMEOUT_SEC=30    # Cap for each preset template handler.execute (seconds)
# ADAMI_INTENT_ACTION_TEMPLATE_REQUIRES_CONFIRMATION=1  # When 1, ACTION-family templates need permission or intent_action_user_ack
# ADAMI_INTENT_ACTION_HITL_TELEGRAM=1  # Step 8.1: show Telegram inline confirm for ACTION templates when nerve is available
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# KIMI_API_KEY=
# QWEN_API_KEY=
# GLM_API_KEY=
# GEMINI_API_KEY=
# GROK_API_KEY=
# GROQ_API_KEY=
# MINIMAX_API_KEY=
# LLM_API_KEY=

# ---------- 机器人 / 代码托管 ----------
# TELEGRAM_BOT_TOKEN=
# If TELEGRAM_BOT_TOKEN is set, you MUST also set TELEGRAM_CHAT_ID (numeric chat id) for bootstrapped UX
# (startup “ready” push + safe fallbacks). If you only want Telegram disabled, leave TELEGRAM_BOT_TOKEN unset.
# TELEGRAM_CHAT_ID=
# DISCORD_BOT_TOKEN=
# If DISCORD_BOT_TOKEN is set, you MUST configure at least one routing default (numeric snowflakes):
# - DISCORD_DEFAULT_USER_ID (recommended; DM bootstrap), and/or
# - DISCORD_DEFAULT_CHANNEL_ID, and/or
# - DISCORD_DEFAULT_GUILD_ID
# If you only want Discord disabled, leave DISCORD_BOT_TOKEN unset.
# DISCORD_DEFAULT_USER_ID=
# DISCORD_DEFAULT_CHANNEL_ID=
# DISCORD_DEFAULT_GUILD_ID=
# Discord slash “/” menu: re-invite the bot with scope applications.commands if commands never appear.
# Optional dev-only: DISCORD_SLASH_GUILD_ID=<guild snowflake> for guild-scoped instant sync (commands won’t show in DM).
# GITHUB_TOKEN=

# ---------- GraphMemory（SQLite 嵌入式图谱；默认 ADAMI_DATA_DIR/graph_memory.db）----------
# ADAMI_GRAPH_MEMORY_SQLITE_PATH=（可选）覆盖图谱库文件路径

# ---------- Runtime profile / DreamSandbox Docker policy ----------
# ADAMI_RUNTIME_PROFILE=development | production
# 未设置时自动：存在 /.dockerenv（内核跑在容器内）→ production，否则 → development。
# production 且未单独 export 覆盖时：关闭宿主机技能沙箱回退（ADAMI_SKIP_DOCKER_SANDBOX=0）、DEBUG=0、
# 只读根文件系统 + cap_drop=ALL 等（见 config.py 中 ADAMI_DOCKER_SANDBOX_*）。
# ADAMI_SKIP_DOCKER_SANDBOX=0
# ADAMI_DOCKER_SANDBOX_READ_ONLY_ROOTFS=0
# ADAMI_DOCKER_SANDBOX_DROP_ALL_CAPABILITIES=0
# ADAMI_DOCKER_SANDBOX_NO_NEW_PRIVILEGES=0
# ADAMI_DOCKER_SANDBOX_TMPFS_TMP_MB=256

# ---------- OpenTelemetry（默认 ADAMI_ENABLE_OBSERVABILITY=true + Console 导出；无 Collector 不写 OTLP）----------
# ADAMI_ENABLE_OBSERVABILITY=0
# ADAMI_OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#
# 采样（Step 8）：未设置 ADAMI_OTEL_TRACES_SAMPLER 时遵循 OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG（规范取值见代码
# ``observability/otel_export_policy.resolve_trace_sampler``）。
# ADAMI_OTEL_TRACES_SAMPLER=parentbased_traceidratio
# ADAMI_OTEL_TRACES_SAMPLER_RATIO=0.25
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1.0
#
# 导出脱敏：在 OTLP/Console 批量写出前对 span 属性与事件属性做键/值脱敏与截断（见 ``RedactingSpanExporter``）。
# ADAMI_OTEL_EXPORT_REDACT_ENABLED=1
# ADAMI_OTEL_EXPORT_ATTR_VALUE_MAX_LEN=2048

# ---------- MCP：第一模块（ADAMI_MCP_*）与第二模块（mcp-agent）----------
# ADAMI_MCP_ENABLED=1
# ADAMI_MCP_MODULE_AGENT_ENABLED=0
# ADAMI_USE_MCP_AGENT=0
# ADAMI_USE_MCP_AGENT_PLANNER=0

# ---------- Sim / 可回放轨迹（模块三，默认关）----------
# ADAMI_SIM_TRACE_EXPORT_ENABLED=1
# ADAMI_SIM_TRACE_EXPORT_PATH=.adami_data/traces/eventbus.ndjson
# ADAMI_SIM_WEBHOOK_ENABLED=1
# ADAMI_SIM_WEBHOOK_URL=https://your-sim.example/webhook/inbox
# ADAMI_SIM_WEBHOOK_SECRET=
# ADAMI_SIM_WORKFLOW_ID=
# ADAMI_SIM_WEBHOOK_MODE=envelope
# ADAMI_SIM_TRACE_TOPICS_ALLOWLIST=

# 模块四：长任务阶段跟踪（DeerFlow 范式）；亦可对单工作流设 metadata.long_task_tracking_enabled
# ADAMI_LONG_TASK_TRACKING_ENABLED=1

# 模块四步骤 6：外部 DeerFlow 侧车（默认关；不安装 deer-flow 包）
# ADAMI_DEERFLOW_ENABLED=1
# ADAMI_DEERFLOW_BASE_URL=https://deerflow.internal.example
# ADAMI_DEERFLOW_TOKEN=
# ADAMI_DEERFLOW_REQUIRE_TOKEN=1
# ADAMI_DEERFLOW_CLI_PATH=/opt/adami/deerflow_cli_adapter.sh

# ---------- 模块五：last30days（外部 CLI 世界传感器，默认关）----------
# ADAMI_LAST30DAYS_ENABLED=1
# ADAMI_LAST30DAYS_SCRIPT_PATH=/abs/path/to/last30days.py
# ADAMI_LAST30DAYS_PYTHON=python3.12
# ADAMI_LAST30DAYS_EMIT_MODE=context
# ADAMI_LAST30DAYS_TIMEOUT_SEC=120
# ADAMI_LAST30DAYS_REFRESH_DEFAULT=0
# Report Studio：生成简报时对 last30days 加 --refresh（默认 1）；简报专用进程内缓存（默认 0）
# ADAMI_REPORT_STUDIO_LAST30DAYS_REFRESH=1
# ADAMI_REPORT_STUDIO_LAST30_CACHE_ENABLED=0
# 简报：外源条目翻译、CoinGecko 现货节、每条最多翻译条数
# ADAMI_REPORT_TRANSLATE_NEWS=1
# ADAMI_REPORT_TRANSLATE_MAX_ITEMS=6
# ADAMI_REPORT_CRYPTO_ENABLED=1
# ADAMI_REPORT_CRYPTO_TIMEOUT_SEC=12
# ADAMI_LAST30DAYS_DAILY_TOPIC=
# ADAMI_LAST30DAYS_WEEKLY_TOPIC=
# ADAMI_LAST30DAYS_WRITE_TO=Inbox
# ADAMI_LAST30DAYS_NOTE_PREFIX=last30days
# 简报落盘前译为 effective_ui_default_locale()（需 ADAMI_TRANSLATE_ENABLED=1 且已配置 API Key）
# ADAMI_LAST30DAYS_TRANSLATE_DIGEST=0
# ADAMI_LAST30DAYS_DIGEST_SOURCE_LOCALE=en（假定 CLI 输出主语言；与目标相同时不调用翻译）

# ---------- Prompt / SecondBrain (non-secret; defaults in config.py) ----------
# Defaults (see config.py): both hints are ON when SecondBrain is injected into PromptBuilder.
# Prefer archived SecondBrain notes before ad-hoc retrieval:
# ADAMI_PROMPT_KNOWLEDGE_WIKI_HINT=0
# Report Studio → SecondBrain SSOT one-liner (doc.pipeline.output_examples_report):
# ADAMI_PROMPT_OUTPUT_EXAMPLES_REPORT_HINT=0

