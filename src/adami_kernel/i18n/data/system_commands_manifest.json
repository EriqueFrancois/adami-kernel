    {"id": "list_memory", "slash": "(natural language)", "telegram_command": null, "discord_register": false, "category": "system", "description_en": "List memory / history (router phrases).", "description_zh": "列出记忆/历史（路由短语）。", "examples": ["列出所有记忆", "list memory"]},
    {"id": "start_evolution", "slash": "(natural language)", "telegram_command": null, "discord_register": false, "category": "system", "description_en": "Start proactive evolution (router phrases).", "description_zh": "启动主动进化（路由短语）。", "examples": ["开始主动进化", "启动进化"]},
    {"id": "report_wizard", "slash": "(text trigger)", "telegram_command": null, "discord_register": false, "category": "report_studio", "description_en": "Open Report wizard UI (port_report_text_triggers).", "description_zh": "打开简报向导界面（见端口触发词）。", "examples": ["/report wizard", "/report config", "report:wizard"]},
    {"id": "adamih", "slash": "/adamih", "telegram_command": "adamih", "discord_register": true, "category": "help", "description_en": "Show this command list (short) in chat.", "description_zh": "在对话中显示本命令列表（摘要）。", "examples": ["/adamih"]}
  ],
  "telegram_notes": [
    "Telegram Bot API command names: lowercase a-z, 0-9, underscore only; max 32 chars; no leading slash in API field.",
