{
  "name": "tool_timeout",
  "applies_when": {
    "payload_event_type": "TOOL_CALL_TIMEOUT"
  },
  "scorecard_defaults": {
    "min_correctness": 100,
    "min_safety": 100,
    "min_ux": 90,
    "min_noise": 100,
    "max_duration_sec": 10.0,
    "weights": {
      "correctness": 0.4,
      "safety": 0.3,
      "ux": 0.2,
      "noise": 0.1
    }
  },
  "assertions_append": [
    {
      "index": 1,
      "assertion": { "expect_payload_keys": ["event_type", "tool", "timeout_sec"] }
    },
    {
      "index": 2,
      "assertion": { "expect_payload_keys": ["event_type", "tool", "timeout_sec"] }
    },
    {
      "index": -1,
      "assertion": { "expect_payload_keys": ["event_type", "text", "trace_id"], "forbid_string": "sk-" }
    }
  ],
  "rules": {
    "require_reply_after_timeout": true
  }
}

