## AdamI private deployment (.env template)
##
## Goal: local-first LLM, safe defaults, and optional OTLP export.

# ---- Runtime profile (recommended for private deployments) ----
ADAMI_RUNTIME_PROFILE=production
DEBUG=false

# ---- Local LLM: Ollama (fallback) ----
OLLAMA_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# ---- Local LLM: MLX (macOS only) ----
ADAMI_MLX_ENABLED=true
ADAMI_MLX_MODEL_PATH=mlx-community/Qwen3.5-9B-MLX-4bit

# ---- Observability ----
ADAMI_ENABLE_OBSERVABILITY=true
ADAMI_OTEL_EXPORTER=console
# ADAMI_OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Sampling / redaction (recommended to keep enabled)
ADAMI_OTEL_TRACES_SAMPLER_RATIO=1.0
ADAMI_OTEL_EXPORT_REDACT_ENABLED=true
ADAMI_OTEL_EXPORT_ATTR_VALUE_MAX_LEN=2048

# ---- Messengers (optional; leave unset in demo) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_DEFAULT_USER_ID=

